{
  "name": "blox-story",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/api.js && node tests/actions.js && node tests/walk.js && node tests/walk-calibration.js && node tests/production.js && node tests/p1.js && node tests/casting.js && node tests/reveal.js && node tests/expressions.js && node tests/ending.js",
    "preview": "python3 -m http.server 8000",
    "test:browser": "node tests/browser.js",
    "test:motion": "node tests/motion-browser.js",
    "test:walk": "node tests/walk-browser.js",
    "test:calibration": "node tests/calibration-browser.js",
    "render:feasibility": "node scripts/render-feasibility.js",
    "sheet:feasibility": "python3 scripts/production-sheet.py",
    "test:p1": "node tests/p1.js && node tests/p1-resume.js",
    "render:shots": "node scripts/render-shot-list.js",
    "test:casting": "node tests/casting-browser.js",
    "test:reveal": "node tests/reveal-browser.js",
    "render:names100": "node scripts/render-shot-list.js --shots stories/names100/scene-proof.json --out renders/names100-animatic",
    "test:v1": "node tests/v1-visual.js",
    "render:names100:v1": "node scripts/render-shot-list.js --shots stories/names100/scene-v1.json --range 343:463 --out renders/names100-v1-excerpt",
    "test:ending": "node tests/ending-browser.js",
    "render:names100:ending": "node scripts/render-shot-list.js --shots stories/names100/scene-ending.json --range 535:665 --out renders/names100-ending-excerpt"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
